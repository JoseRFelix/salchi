{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vercel.ts",
    "test",
    "../../scripts/lib/brand-assets.ts",
    "../../scripts/lib/client-build-metadata.ts",
    "../../scripts/lib/precompressed-assets.ts"
  ]
}
